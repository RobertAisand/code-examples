&После("ПриСозданииНаСервере")
Процедура рс_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	ТекстЗапроса = Список.ТекстЗапроса;
	
	// Точка вставки в типовой запрос. Если структура запроса изменится
	// в другой версии конфигурации, доработка просто не применится.
	ТочкаВставки = "КОНЕЦ КАК ЕстьФайлы";
	
	Если СтрНайти(ТекстЗапроса, ТочкаВставки) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Добавляем поле суммы реализаций в секцию ВЫБРАТЬ
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		ТочкаВставки,
		"КОНЕЦ КАК ЕстьФайлы,
		|	ЕСТЬNULL(рс_Реализации.СуммаРеализации, 0) КАК рс_СуммаРеализации");
	
	// Суммы группируются по счёту ДО соединения со списком:
	// иначе счёт с несколькими реализациями размножит строки в списке.
	// Строки товаров и услуг объединяются, так как счёт может быть указан в обеих ТЧ.
	// Если в строке счёт не заполнен, берётся счёт из шапки реализации.
	ТекстЗапроса = ТекстЗапроса + "
	|	ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|		СтрокиРеализаций.Счет КАК Счет,
	|		СУММА(СтрокиРеализаций.Сумма) КАК СуммаРеализации
	|	ИЗ
	|		(ВЫБРАТЬ
	|			ВЫБОР
	|				КОГДА Товары.СчетНаОплатуПокупателю = ЗНАЧЕНИЕ(Документ.СчетНаОплатуПокупателю.ПустаяСсылка)
	|					ТОГДА Товары.Ссылка.СчетНаОплатуПокупателю
	|				ИНАЧЕ Товары.СчетНаОплатуПокупателю
	|			КОНЕЦ КАК Счет,
	|			Товары.Сумма КАК Сумма
	|		ИЗ
	|			Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|		ГДЕ
	|			Товары.Ссылка.Проведен
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
	|		
	|		ВЫБРАТЬ
	|			ВЫБОР
	|				КОГДА Услуги.СчетНаОплатуПокупателю = ЗНАЧЕНИЕ(Документ.СчетНаОплатуПокупателю.ПустаяСсылка)
	|					ТОГДА Услуги.Ссылка.СчетНаОплатуПокупателю
	|				ИНАЧЕ Услуги.СчетНаОплатуПокупателю
	|			КОНЕЦ,
	|			Услуги.Сумма
	|		ИЗ
	|			Документ.РеализацияТоваровУслуг.Услуги КАК Услуги
	|		ГДЕ
	|			Услуги.Ссылка.Проведен) КАК СтрокиРеализаций
	|	
	|	СГРУППИРОВАТЬ ПО
	|		СтрокиРеализаций.Счет) КАК рс_Реализации
	|	ПО ДокументСчетНаОплатуПокупателю.Ссылка = рс_Реализации.Счет";
	
	Список.ТекстЗапроса = ТекстЗапроса;
	
	// Колонка добавляется программно: поле появляется в запросе только
	// во время выполнения, поэтому в конфигураторе его выбрать нельзя
	НовоеПоле = Элементы.Добавить("рс_СуммаРеализации",
		Тип("ПолеФормы"), Элементы.Список);
	НовоеПоле.Вид = ВидПоляФормы.ПолеНадписи;
	НовоеПоле.ПутьКДанным = "Список.рс_СуммаРеализации";
	НовоеПоле.Заголовок = "Сумма реализации";
	НовоеПоле.Формат = "ЧЦ=15; ЧДЦ=2; ЧН=0";
	
КонецПроцедуры