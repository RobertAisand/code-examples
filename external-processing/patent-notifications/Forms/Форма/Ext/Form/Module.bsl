#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
    СформироватьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формирует в табличном документе список действующих сотрудников со статусом
// "Нерезидент, работающий по найму на основании патента" и данными уведомления
// об авансовых платежах за текущий год.
&НаСервере
Процедура СформироватьНаСервере()

    Данные = ПолучитьДанные();
    Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");

    ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
    ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
    ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
    ОбластьНетДанных = Макет.ПолучитьОбласть("НетДанных");
    ОбластьИтого = Макет.ПолучитьОбласть("Итого");

    ОбластьЗаголовок.Параметры.Год = Формат(Год(ТекущаяДатаСеанса()), "ЧГ=0");

    Результат.Очистить();
    Результат.Вывести(ОбластьЗаголовок);
    Результат.Вывести(ОбластьШапка);

    Если Данные.Количество() = 0 Тогда
        Результат.Вывести(ОбластьНетДанных);
    Иначе
        Для Каждого СтрокаДанных Из Данные Цикл
            ОбластьСтрока.Параметры.ФИО = СтрокаДанных.ФИО;
            ОбластьСтрока.Параметры.Организация = СтрокаДанных.Организация;
            ОбластьСтрока.Параметры.НомерУведомления = СтрокаДанных.НомерУведомления;
            Если ЗначениеЗаполнено(СтрокаДанных.ДатаУведомления) Тогда
                ОбластьСтрока.Параметры.ДатаУведомления = Формат(СтрокаДанных.ДатаУведомления, "ДЛФ=D");
            Иначе
                ОбластьСтрока.Параметры.ДатаУведомления = "";
            КонецЕсли;
            Результат.Вывести(ОбластьСтрока);
        КонецЦикла;
    КонецЕсли;

    ОбластьИтого.Параметры.Количество = Данные.Количество();
    Результат.Вывести(ОбластьИтого);

КонецПроцедуры

// Возвращает данные для отчета.
//
// Возвращаемое значение:
//  ТаблицаЗначений - ФИО, Организация, НомерУведомления, ДатаУведомления
&НаСервереБезКонтекста
Функция ПолучитьДанные()

    ТекущаяДата = ТекущаяДатаСеанса();

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Кадры.ФизическоеЛицо КАК ФизическоеЛицо,
    |    ВЫБОР
    |        КОГДА Кадры.ТекущаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
    |            ТОГДА Кадры.ГоловнаяОрганизация
    |        ИНАЧЕ Кадры.ТекущаяОрганизация
    |    КОНЕЦ КАК Организация,
    |    Кадры.ГоловнаяОрганизация КАК ГоловнаяОрганизация
    |ПОМЕСТИТЬ ВТСотрудники
    |ИЗ
    |    РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК Кадры
    |ГДЕ
    |    Кадры.ДатаПриема <= &Дата
    |    И (Кадры.ДатаУвольнения = ДАТАВРЕМЯ(1, 1, 1)
    |        ИЛИ Кадры.ДатаУвольнения >= &Дата)
    |
    |ИНДЕКСИРОВАТЬ ПО
    |    ФизическоеЛицо
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    Статусы.ФизическоеЛицо КАК ФизическоеЛицо
    |ПОМЕСТИТЬ ВТСтатусы
    |ИЗ
    |    РегистрСведений.СтатусФизическихЛицКакНалогоплательщиковНДФЛ.СрезПоследних(&Дата, ) КАК Статусы
    |ГДЕ
    |    Статусы.Статус = &СтатусПатент
    |
    |ИНДЕКСИРОВАТЬ ПО
    |    ФизическоеЛицо
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗЛИЧНЫЕ
    |    ФизическиеЛица.Наименование КАК ФИО,
    |    Организации.Наименование КАК Организация,
    |    Уведомления.НомерУведомления КАК НомерУведомления,
    |    Уведомления.ДатаУведомления КАК ДатаУведомления
    |ИЗ
    |    ВТСотрудники КАК Сотрудники
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСтатусы КАК Статусы
    |        ПО Сотрудники.ФизическоеЛицо = Статусы.ФизическоеЛицо
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
    |        ПО Сотрудники.ФизическоеЛицо = ФизическиеЛица.Ссылка
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
    |        ПО Сотрудники.Организация = Организации.Ссылка
    |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыУведомленияИФНСНаЗачетАвансовыхПлатежей КАК Уведомления
    |        ПО Сотрудники.ФизическоеЛицо = Уведомления.ФизическоеЛицо
    |            И Сотрудники.ГоловнаяОрганизация = Уведомления.ГоловнаяОрганизация
    |            И Уведомления.Год = &Год
    |
    |УПОРЯДОЧИТЬ ПО
    |    ФИО";

    Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДата));
    Запрос.УстановитьПараметр("Год", Год(ТекущаяДата));
    Запрос.УстановитьПараметр("СтатусПатент",
                Справочники.СтатусыНалогоплательщиковПоНДФЛ.НерезидентРаботающийНаОснованииПатента);

    Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти