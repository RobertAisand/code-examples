// Клиент для HTTP-сервиса ТоварыAPI. Работает в любой другой базе 1С.

// Возвращает остаток товара по артикулу или Неопределено, если артикул не найден.
//
// Параметры:
//  Сервер      - Строка - адрес сервера, например "localhost"
//  Публикация  - Строка - имя публикации базы на веб-сервере
//  Артикул     - Строка
//  Логин, Пароль - Строка - пользователь с доступом к сервису
Функция ОстатокПоАртикулу(Сервер, Публикация, Артикул, Логин, Пароль) Экспорт

    Соединение = Новый HTTPСоединение(Сервер, 80, Логин, Пароль, , 10);

    Путь = "/" + Публикация + "/hs/api/v1/stock/"
        + КодироватьСтроку(Артикул, СпособКодированияСтроки.КодировкаURL);
    Ответ = Соединение.Получить(Новый HTTPЗапрос(Путь));

    Если Ответ.КодСостояния = 404 Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение "Сервис вернул код " + Ответ.КодСостояния;
    КонецЕсли;

    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
    Данные = ПрочитатьJSON(Чтение, Истина);
    Чтение.Закрыть();

    Возврат Данные["stock"];

КонецФункции
