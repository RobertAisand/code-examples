// Примеры запросов 1С (УТ 11.5): виртуальные таблицы, группировка с итогами, пакет с временной таблицей.
// Во всех функциях значения передаются через параметры запроса, а не склейкой строк.

// Остатки товаров по складам на дату.
// Параметры отбора передаются в виртуальную таблицу, а не в ГДЕ: так СУБД отбирает записи
// на уровне регистра и не читает лишнего.
//
// Параметры:
//  Дата   - Дата - момент, на который нужны остатки
//  Склады - Массив - склады (СправочникСсылка.Склады)
//
// Возвращаемое значение:
//  ТаблицаЗначений - Склад, Номенклатура, Остаток
Функция ОстаткиТоваровПоСкладам(Дата, Склады) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Склад КАК Склад,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	СУММА(Остатки.ВНаличииОстаток) КАК Остаток
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&Дата, Склад В (&Склады)) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Склад,
	|	Остатки.Номенклатура
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.ВНаличииОстаток) > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склад,
	|	Номенклатура";

	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Склады", Склады);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Продажи по клиентам за период, разбитые на классы A, B и C по сумме.
// Первый запрос пакета считает сумму по клиентам во временную таблицу,
// второй присваивает класс через ВЫБОР и строит итоги по классу.
//
// Параметры:
//  НачалоПериода, КонецПериода - Дата - границы периода
//  ГраницаА - Число - клиенты с суммой не меньше этого значения получают класс A
//  ГраницаВ - Число - клиенты с суммой не меньше этого значения получают класс B
//
// Возвращаемое значение:
//  ДеревоЗначений - первый уровень: класс, второй уровень: клиенты
Функция ПродажиПоКлиентамСКлассами(НачалоПериода, КонецПериода, ГраницаА, ГраницаВ) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Реализация.Партнер КАК Партнер,
	|	СУММА(Реализация.СуммаДокумента) КАК Сумма
	|ПОМЕСТИТЬ ВТПродажи
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ
	|	Реализация.Проведен
	|	И Реализация.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|СГРУППИРОВАТЬ ПО
	|	Реализация.Партнер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Продажи.Сумма >= &ГраницаА
	|			ТОГДА ""A""
	|		КОГДА Продажи.Сумма >= &ГраницаВ
	|			ТОГДА ""B""
	|		ИНАЧЕ ""C""
	|	КОНЕЦ КАК Класс,
	|	Продажи.Партнер КАК Партнер,
	|	Продажи.Сумма КАК Сумма
	|ИЗ
	|	ВТПродажи КАК Продажи
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сумма УБЫВ
	|
	|ИТОГИ
	|	СУММА(Сумма),
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Партнер)
	|ПО
	|	Класс";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("ГраницаА", ГраницаА);
	Запрос.УстановитьПараметр("ГраницаВ", ГраницаВ);

	Возврат Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);

КонецФункции

// Залежавшиеся товары: есть остаток на конец периода, но не было ни одной продажи за период.
// Пакет из двух запросов: продажи собираются во временную таблицу с индексом,
// затем остатки соединяются с ней. Так не нужно искать продажи отдельным запросом
// для каждого товара в цикле.
//
// Параметры:
//  НачалоПериода, КонецПериода - Дата - период, за который проверяются продажи
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Остаток
Функция ЗалежавшиесяТовары(НачалоПериода, КонецПериода) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыРеализации.Номенклатура КАК Номенклатура,
	|	СУММА(ТоварыРеализации.Количество) КАК Продано
	|ПОМЕСТИТЬ ВТПродажи
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК ТоварыРеализации
	|ГДЕ
	|	ТоварыРеализации.Ссылка.Проведен
	|	И ТоварыРеализации.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыРеализации.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	СУММА(Остатки.ВНаличииОстаток) КАК Остаток
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&КонецПериода, ) КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПродажи КАК Продажи
	|		ПО Остатки.Номенклатура = Продажи.Номенклатура
	|ГДЕ
	|	Продажи.Номенклатура ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.ВНаличииОстаток) > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остаток УБЫВ";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	// Выполнить() возвращает результат последнего запроса пакета.
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции