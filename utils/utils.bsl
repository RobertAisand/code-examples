// Проверяет корректность ИНН юридического (10 цифр) или физического (12 цифр) лица
// по контрольным разрядам.
//
// Параметры:
//  ИНН - Строка - проверяемый ИНН
//
// Возвращаемое значение:
//  Булево - Истина, если ИНН корректен
Функция ИННКорректен(Знач ИНН) Экспорт

    ИНН = СокрЛП(ИНН);

    Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
        Возврат Ложь;
    КонецЕсли;

    Для Позиция = 1 По СтрДлина(ИНН) Цикл
        Если СтрНайти("0123456789", Сред(ИНН, Позиция, 1)) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;

    Если СтрДлина(ИНН) = 10 Тогда
        Возврат КонтрольныйРазряд(ИНН, "2,4,10,3,5,9,4,6,8") = Число(Сред(ИНН, 10, 1));
    КонецЕсли;

    Возврат КонтрольныйРазряд(ИНН, "7,2,4,10,3,5,9,4,6,8") = Число(Сред(ИНН, 11, 1))
        И КонтрольныйРазряд(ИНН, "3,7,2,4,10,3,5,9,4,6,8") = Число(Сред(ИНН, 12, 1));

КонецФункции

// Записывает ошибку в журнал регистрации с подробным текстом исключения.
//
// Параметры:
//  ИмяСобытия - Строка - имя события в журнале, например "Обмен.Загрузка"
//  ИнформацияОбОшибке - ИнформацияОбОшибке - перехваченное исключение
//  Комментарий - Строка - дополнительный текст, необязательный
Процедура ЗаписатьИсключение(Знач ИмяСобытия, Знач ИнформацияОбОшибке, Знач Комментарий = "") Экспорт

    ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
    Если Не ПустаяСтрока(Комментарий) Тогда
        ТекстОшибки = Комментарий + Символы.ПС + ТекстОшибки;
    КонецЕсли;

    ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);

КонецПроцедуры

// Вычисляет контрольный разряд ИНН по строке весовых коэффициентов.
Функция КонтрольныйРазряд(ИНН, СтрокаКоэффициентов)

    Коэффициенты = СтрРазделить(СтрокаКоэффициентов, ",");

    Сумма = 0;
    Для Индекс = 0 По Коэффициенты.ВГраница() Цикл
        Сумма = Сумма + Число(Сред(ИНН, Индекс + 1, 1)) * Число(Коэффициенты[Индекс]);
    КонецЦикла;

    Возврат (Сумма % 11) % 10;

КонецФункции
